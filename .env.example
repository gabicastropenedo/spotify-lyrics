# Copia este archivo como ".env" y rellena los valores

# 1. Ve a https://developer.spotify.com/dashboard y crea una app
# 2. En "Edit Settings" -> "Redirect URIs" añade la URL de esta app + "/callback"
#    - En local (pruebas): tu IP de red. Ej: http://192.168.1.60:3000/callback
#    - En hosting/remoto: la URL HTTPS. Ej: https://tu-app.onrender.com/callback
# 3. Copia el Client ID y Client Secret aquí
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui

# URL externa de la app (OPCIONAL):
# - DÉJALA VACÍA en local: el servidor detecta tu IP y construye la URL con el puerto.
# - En hosting/remoto: pon la URL HTTPS completa (sin /callback).
#   Ej: BASE_URL=https://tu-app.onrender.com
# BASE_URL=

# Puerto del servidor (opcional)
PORT=3000

# Solo si necesitas forzar un host concreto (por defecto se detecta la IP local automáticamente)
# HOST=0.0.0.0
